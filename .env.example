GEMINI_API_KEY=place_holder_for_your_api_key
GEMINI_MODEL=gemini-flash-latest
# ElevenLabs voices for the ocean guides (read-aloud). Optional: without it the browser's voice is used.
ELEVENLABS_API_KEY=place_holder_for_your_api_key
ELEVENLABS_MODEL=eleven_v4
# Optional per-guide voice overrides (voice IDs from elevenlabs.io/app/voice-library):
# ELEVENLABS_VOICE_PINCH=
PORT=3000
# Optional for deployment: where the leaderboard is saved (use a persistent disk path on your host),
# and set TRUST_PROXY=0 only if the app is NOT behind a proxy and is reached directly.
# DATA_DIR=/var/data
# TRUST_PROXY=1
